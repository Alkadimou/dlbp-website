rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Staff roles live in /staff/{email} (lowercased email as document ID):
    //   { role: "admin" | "scanner" | "pr", prCode: "<code>" (pr only) }
    // Accounts are created only by the admin in the Firebase Console
    // (public sign-up is disabled), so the token email is trusted.
    function staffPath() {
      return /databases/$(database)/documents/staff/$(request.auth.token.email.lower());
    }

    function isStaff() {
      return request.auth != null && request.auth.token.email is string && exists(staffPath());
    }

    function hasRole(role) {
      return isStaff() && get(staffPath()).data.role == role;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isScanner() {
      return hasRole('scanner');
    }

    // A PR may only see guests who registered with their own code
    function isPrFor(code) {
      return hasRole('pr') && get(staffPath()).data.prCode == code;
    }

    // Staff: each account can read its own role, only admins manage roles
    match /staff/{email} {
      allow read: if isAdmin() || (request.auth != null && request.auth.token.email is string
                                   && request.auth.token.email.lower() == email);
      allow write: if isAdmin();
    }

    // Events: public read, write by admins
    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Registrations:
    // - Public creation (guestlist registration on site), with validated fields
    // - Admins: full access. Scanner: read and check-in only. PR: read own guests only.
    // - Public: after registering, may only mark the ticket email as sent (email_sent false -> true).
    match /registrations/{regId} {
      allow create: if isAdmin() || isValidRegistration(request.resource.data);
      allow read: if isAdmin() || isScanner() || isPrFor(resource.data.invited_by);
      allow update: if isAdmin() || (isScanner() && isCheckIn()) || isTicketEmailSent();
      allow delete: if isAdmin();
    }

    function isValidRegistration(data) {
      return data.keys().hasOnly(['name', 'first_name', 'last_name', 'email', 'eventId', 'invited_by',
                                  'checked_in', 'status', 'email_sent', 'privacy_consent', 'timestamp'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && hasValidNameParts(data)
        && data.email is string && data.email.size() <= 254
        && data.email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$')
        && data.eventId is string
        && exists(/databases/$(database)/documents/events/$(data.eventId))
        // Capienza 0 = evento solo da vedere, senza iscrizioni
        && get(/databases/$(database)/documents/events/$(data.eventId)).data.get('maxCapacity', 100) != 0
        && (data.invited_by == null || (data.invited_by is string && data.invited_by.size() <= 50))
        && data.checked_in == false
        && data.status == 'approved'
        && data.email_sent == false
        && data.privacy_consent == true
        && data.timestamp == request.time;
    }

    // Nome e cognome separati, obbligatori: "name" deve essere "NOME COGNOME".
    function hasValidNameParts(data) {
      return data.first_name is string && data.first_name.size() > 0 && data.first_name.size() <= 50
        && data.last_name is string && data.last_name.size() > 0 && data.last_name.size() <= 50
        && data.name == data.first_name + ' ' + data.last_name;
    }

    // Scanner may only flip checked_in to true and set the check-in time (as a Firestore Timestamp)
    function isCheckIn() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['checked_in', 'check_in_time'])
        && resource.data.checked_in != true
        && request.resource.data.checked_in == true
        && request.resource.data.check_in_time is timestamp;
    }

    // Il sito segna che l'email del biglietto è partita: cambia solo email_sent, da false a true
    function isTicketEmailSent() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email_sent'])
        && resource.data.email_sent == false
        && request.resource.data.email_sent == true;
    }

    // PRs: admins manage them, a PR can read their own entry
    match /prs/{prId} {
      allow read: if isAdmin() || isPrFor(resource.data.code);
      allow write: if isAdmin();
    }

    // Contacts for invitations: nobody can read or list them from the site.
    // The document ID is a random 20-character secret sent only in that person's
    // unsubscribe link, so whoever has the link can delete that one contact.
    // The admin can only correct the name (firstName, lastName), together with the invite.
    match /contacts/{contactId} {
      allow delete: if contactId.size() == 20;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['firstName', 'lastName']);
    }

    // Invitations: a copy of each contact with only name, surname and email (no phone),
    // same secret ID. The PARTECIPA link carries the ID, so the registration form can
    // read that one invite to prefill itself; it is deleted with the contact on unsubscribe.
    // The admin can create or update one only if it matches the contact exactly
    // (as it is after the same batch, so a name correction changes both together).
    match /invites/{inviteId} {
      allow get, delete: if inviteId.size() == 20;
      allow create, update: if isAdmin()
        && existsAfter(/databases/$(database)/documents/contacts/$(inviteId))
        && request.resource.data.keys().hasOnly(['firstName', 'lastName', 'email'])
        && request.resource.data.firstName == getAfter(/databases/$(database)/documents/contacts/$(inviteId)).data.firstName
        && request.resource.data.lastName == getAfter(/databases/$(database)/documents/contacts/$(inviteId)).data.lastName
        && request.resource.data.email == getAfter(/databases/$(database)/documents/contacts/$(inviteId)).data.email;
    }

    // Legacy global settings (registration open/closed)
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
