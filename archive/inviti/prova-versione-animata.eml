=3D 26;
    const seq =3D Array.from({ length: LEN }, () =3D> BASES[(Math.random() * =
4) | 0]);
    const t0 =3D performance.now();
    function tick() {
        seq.shift();
        seq.push(BASES[(Math.random() * 4) | 0]);
        const out =3D seq.slice();
        const word =3D MOODS[state.mood].word.toUpperCase();
        const cycle =3D (performance.now() - t0) % 7000;
        if (cycle > 3800) {
            const start =3D ((LEN - word.length) / 2) | 0;
            const shown =3D Math.min(word.length, Math.floor((cycle - 3800) /=
 90));
            for (let k =3D 0; k < word.length; k++) out[start + k] =3D k < sh=
own ? word[k] : NOISE[(Math.random() * NOISE.length) | 0];
            out[start - 1] =3D '=C2=B7';
            out[start + word.length] =3D '=C2=B7';
        }
        if (state.glitch > 0.05) {
            for (let n =3D 0; n < 6; n++) out[(Math.random() * LEN) | 0] =3D =
NOISE[(Math.random() * NOISE.length) | 0];
        }
        el.textContent =3D out.join(' ');
