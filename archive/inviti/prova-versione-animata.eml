rtenza; il colore
// raggiunto resta per tutta la visita, anche cambiando pagina.
// Il colore arriva al CSS come --mood e --mood-deep su <html>.
// Con data-lite sull'elemento (scanner) gira in versione leggera. Sugli sche=
rmi a 120 Hz o pi=C3=B9
// disegna al massimo circa 60 fotogrammi al secondo, per consumare meno batt=
eria.
// Con data-tap (pagine pubbliche) il cursore =C3=A8 una croce su tutta la pa=
gina tranne link, bottoni e campi
// (css/identity.css) e un clic dove c'=C3=A8 la croce fa partire un glitch, =
come nell'artifact "Cromo e Colore".
// Carica anche no-zoom.js (niente ingrandimento su telefono), perch=C3=A9 qu=
esto file c'=C3=A8 in ogni pagina.


const THREE_URL =3D 'https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/thr=
ee.min.js';

export const MOODS =3D {
    strobo:   { word: 'drink',   hex: 0xff2a3c, deep: 0x4d0712 }, // rosso st=
robo
    magenta:  { word: 'love',    hex: 0x8a2c80, deep: 0x250a24 }, // bordeaux=
 violaceo
    breathe:  { word: 'breathe', hex: 0x1fa39a, deep: 0x062f35 }, // petrolio
    ghiaccio: { word: 'peace',   hex: 0xcfe6ff, deep: 0x34506e }  // ghiaccio=
, luce del mattino
};
const DEFAULT_MOOD =3D 'magenta';
const ORDER =3D ['strobo', 'magenta', 'breathe', 'ghiaccio'];
const COLOR_EVERY_MS =3D 5000; // cambio colore ogni 5 secondi (sul sito: ogn=
i 3 glitch)

function saveMood(mood) {
    try { sessionStorage.setItem('dlbp-mood', mood); } catch (e) { /* session=
Storage non disponibile */ }
}

function readMood() {
    const param =3D new URLSearchParams(location.search).get('mood');
    // accetta sia un colore (?mood=3Dmagenta) sia una parola del motto (?moo=
d=3Ddrink =E2=86=92 il suo primo colore)
    const fromUrl =3D MOODS[param] ? param : ORDER.find((id) =3D> MOODS[id].w=
ord =3D=3D=3D param);
    if (fromUrl) {
        saveMood(fromUrl);
        return fromUrl;
    }
    try {
        const saved =3D sessionStorage.getItem('dlbp-mood');
        if (MOODS[saved]) return saved;
    } catch (e) { /* sessionStorage non disponibile */ }
    return DEFAULT_MOOD;
}

const cssHex =3D (n) =3D> '#' + n.toString(16).padStart(6, '0');

// luminanza relativa (WCAG) di un colore 0xRRGGBB
function luminance(n) {
    const lin =3D (c) =3D> { c /=3D 255; return c <=3D 0.03928 ? c / 12.92 : =
Math.pow((c + 0.055) / 1.055, 2.4); };
    return 0.2126 * lin((n >> 16) & 255) + 0.7152 * lin((n >> 8) & 255) + 0.0=
722 * lin(n & 255);
}

function setCssMood(m) {
    const root =3D document.documentElement;
    root.dataset.mood =3D m;
    root.style.setProperty('--mood', cssHex(MOODS[m].hex));
    root.style.setProperty('--mood-deep', cssHex(MOODS[m].deep));
    // testo dei bottoni pieni: chiaro sui colori scuri, scuro su quelli chia=
ri
    root.style.setProperty('--on-mood', luminance(MOODS[m].hex) < 0.18 ? '#f3=
f2ee' : '#050508');
}

const state =3D { mood: readMood(), glitch: 0, power: 0, seed: 0, lastSeed: 0=
, burstEnd: 0, nextBurst: 2500, bursts: 0, pending: null, swapAt: 0 };
setCssMood(state.mood);

const reduce =3D window.matchMedia('(prefers-reduced-motion: reduce)').matche=
s;

function loadThree() {
    return new Promise((resolve, reject) =3D> {
        if (window.THREE) return resolve(window.THREE);
        const s =3D document.createElement('script');
        s.src =3D THREE_URL;
        s.async =3D true;
        s.onload =3D () =3D> resolve(window.THREE);
        s.onerror =3D reject;
        document.head.appendChild(s);
    });
}

const ENV_VERT =3D 'varying vec3 vDir; void main(){ vDir =3D normalize(positi=
on); gl_Position =3D projectionMatrix * modelViewMatrix * vec4(position, 1.0)=
; }';
// "Studio" nero con strisce di luce bianca e la luce del motto dal basso: =
=C3=A8 quello che il cromo riflette
const ENV_FRAG =3D `
uniform vec3 uMood; varying vec3 vDir;
float band(float x, float c, float w){ return 1.0 - smoothstep(0.0, w, abs(x =
- c)); }
void main(){
  vec3 d =3D normalize(vDir);
  vec3 c =3D vec3(0.003);
  c +=3D vec3(7.0) * smoothstep(0.88, 0.97, d.y);
  c +=3D vec3(3.0) * band(d.y, 0.38, 0.045);
  c +=3D vec3(3.5) * band(d.x, 0.78, 0.05) * step(-0.25, d.y);
  c +=3D vec3(1.6) * band(d.x, -0.72, 0.035) * step(0.05, d.y);
  c +=3D uMood * 5.0 * smoothstep(-0.05, -0.85, d.y);
  c +=3D uMood * 2.5 * band(d.y, -0.04, 0.12);
  c +=3D uMood * 1.8 * smoothstep(0.1, 1.0, -d.z) * smoothstep(-0.4, 0.4, d.x=
);
  gl_FragColor =3D linearToOutputTexel(vec4(c, 1.0));
}`;

const BG_VERT =3D 'varying vec2 vUv; void main(){ vUv =3D uv; gl_Position =3D=
 projectionMatrix * modelViewMatrix * vec4(position, 1.0); }';
// Sfumatura come nei flyer: il colore della serata sale verso il nero
const BG_FRAG =3D `
uniform vec3 uMood; uniform vec3 uDeep; uniform vec2 uGlow; uniform float uAs=
pect; uniform float uRadius; varying vec2 vUv;
void main(){
  // distanza misurata in altezze di schermo, cos=C3=AC il bagliore resta rot=
ondo su ogni formato
  float d =3D smoothstep(uRadius, 0.0, length((vUv - uGlow) * vec2(uAspect, 0=
.8)));
  vec3 c =3D mix(vec3(0.0), uDeep * 0.55, smoothstep(0.0, 0.8, d));
  c +=3D uMood * 0.22 * pow(d, 3.0);
  gl_FragColor =3D linearToOutputTexel(vec4(c, 1.0));
}`;

const POST_VERT =3D 'varying vec2 vUv; void main(){ vUv =3D uv; gl_Position =
=3D vec4(position.xy, 0.0, 1.0); }';
// Passaggio finale: separazione RGB, righe strappate, blocchi, righe del mon=
itor, grana
const POST_FRAG =3D `
uniform sampler2D tDiffuse; uniform float uTime; uniform float uGlitch; unifo=
rm float uSeed;
uniform vec2 uRes; uniform vec3 uMood; uniform float uDim;
varying vec2 vUv;
float rnd(vec2 p){ return fract(sin(dot(p, vec2(12.9898, 78.233))) * 43758.54=
53); }
void main(){
  vec2 uv =3D vUv; float g =3D uGlitch;
  float rows =3D 10.0 + floor(rnd(vec2(uSeed, 3.1)) * 50.0);
  float sl =3D floor(uv.y * rows); float r =3D rnd(vec2(sl, uSeed));
  uv.x +=3D step(1.0 - 0.5 * g, r) * (rnd(vec2(sl, uSeed + 7.0)) - 0.5) * 0.2=
8 * g;
  vec2 bl =3D floor(vUv * vec2(9.0, 20.0) + uSeed);
  float b =3D rnd(bl);
  uv +=3D step(1.0 - 0.14 * g, b) * (vec2(rnd(bl + 1.3), rnd(bl + 2.7)) - 0.5=
) * 0.14;
  float cr =3D rnd(vec2(floor(vUv.x * 36.0), uSeed + 11.0));
  if (cr > 1.0 - 0.12 * g) uv.y =3D floor(uv.y * 5.0) / 5.0 + 0.1;
  vec2 fc =3D vUv - 0.5;
  vec2 ca =3D fc * (0.006 + 0.03 * g) + vec2(0.02 * g * (r - 0.5), 0.0);
  vec3 col =3D vec3(texture2D(tDiffuse, uv + ca).r, texture2D(tDiffuse, uv).g=
, texture2D(tDiffuse, uv - ca).b);
  col =3D mix(col, uMood * (0.55 + 0.7 * col.g), step(1.0 - 0.06 * g, rnd(bl =
+ 9.1)) * 0.9);
  col =3D mix(col, 1.0 - col, step(1.0 - 0.03 * g, rnd(bl + 4.4)));
  col *=3D 0.92 + 0.08 * sin(vUv.y * uRes.y * 1.5708);
  col +=3D (rnd(vUv * uRes + fract(uTime * 0.37)) - 0.5) * (0.04 + 0.1 * g);
  float roll =3D fract(uTime * 0.06);
  col +=3D uMood * 0.18 * (1.0 - smoothstep(0.0, 0.003, abs(vUv.y - roll)));
  col *=3D smoothstep(1.05, 0.3, length(fc * vec2(1.0, 1.15)) * 1.25);
  col *=3D uDim;
  gl_FragColor =3D vec4(col, 1.0);
}`;

function createView(THREE, host) {
    const lite =3D host.hasAttribute('data-lite');
    const dim =3D parseFloat(host.dataset.dim || '1');
    const canvas =3D document.createElement('canvas');
    host.appendChild(canvas);

    let renderer;
    try {
        renderer =3D new THREE.WebGLRenderer({ canvas, antialias: false, powe=
rPreference: lite ? 'low-power' : 'high-performance' });
    } catch (e) {
        canvas.remove();
        return null;
    }
    const dpr =3D lite ? 1 : Math.min(window.devicePixelRatio || 1, 2);
    renderer.setPixelRatio(dpr);
    renderer.toneMapping =3D THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure =3D 1.05;

    const linear =3D (hex) =3D> new THREE.Color(hex).convertSRGBToLinear();
    const mood =3D MOODS[state.mood];
    const timeU =3D { value: 0 };
    const scene =3D new THREE.Scene();
    const camera =3D new THREE.PerspectiveCamera(34, 1, 0.1, 100);

    // un riflesso gi=C3=A0 pronto per ogni colore, cos=C3=AC il cambio =C3=
=A8 istantaneo
    const pmrem =3D new THREE.PMREMGenerator(renderer);
    const envUniforms =3D { uMood: { value: new THREE.Color() } };
    const envScene =3D new THREE.Scene();
    envScene.add(new THREE.Mesh(new THREE.SphereGeometry(10, 64, 32), new THR=
EE.ShaderMaterial({
        side: THREE.BackSide, vertexShader: ENV_VERT, fragmentShader: ENV_FRA=
G, uniforms: envUniforms
    })));
    const envs =3D {};
    ORDER.forEach((m) =3D> {
        envUniforms.uMood.value.copy(linear(MOODS[m].hex));
        envs[m] =3D pmrem.fromScene(envScene, 0.02).texture;
    });
    scene.environment =3D envs[state.mood];

    const bgMat =3D new THREE.ShaderMaterial({
        depthWrite: false, toneMapped: false, vertexShader: BG_VERT, fragment=
Shader: BG_FRAG,
        uniforms: { uMood: { value: linear(mood.hex) }, uDeep: { value: linea=
r(mood.deep) }, uGlow: { value: new THREE.Vector2(0.58, 0.4) }, uAspect: { va=
lue: 1 }, uRadius: { value: 0.62 } }
    });
    // il pannello viene ridimensionato in resize() per coprire sempre tutto =
lo schermo
    const bg =3D new THREE.Mesh(new THREE.PlaneGeometry(1, 1), bgMat);
    bg.position.z =3D -9;
    scene.add(bg);

    // superficie che ondeggia come metallo fuso
    function liquid(mat, amount) {
        mat.onBeforeCompile =3D (sh) =3D> {
            sh.uniforms.uTime =3D timeU;
            sh.vertexShader =3D 'uniform float uTime;\n' + sh.vertexShader.re=
place('#include <begin_vertex>',
                '#include <begin_vertex>\n' +
                'vec3 wp =3D (modelMatrix * vec4(position, 1.0)).xyz;\n' +
                'float w =3D sin(wp.y * 2.1 + uTime * 1.5) * 0.5 + sin(wp.x *=
 3.7 - wp.z * 2.9 + uTime * 1.1) * 0.35 + sin(wp.y * 6.5 - uTime * 2.4) * 0.1=
8;\n' +
                'transformed +=3D normal * w * ' + amount.toFixed(3) + ';');
        };
        return mat;
    }

    class HelixCurve extends THREE.Curve {
        constructor(radius, height, turns, phase) { super(); this.r =3D radiu=
s; this.h =3D height; this.t =3D turns; this.p =3D phase; }
        getPoint(u, target =3D new THREE.Vector3()) {
            const a =3D u * Math.PI * 2 * this.t + this.p;
            return target.set(Math.cos(a) * this.r, (u - 0.5) * this.h, Math.=
sin(a) * this.r);
        }
    }

    const chrome =3D liquid(new THREE.MeshStandardMaterial({ color: 0xffffff,=
 metalness: 1, roughness: 0.1 }), 0.08);
    const chromeSolid =3D new THREE.MeshStandardMaterial({ color: 0xdedee6, m=
etalness: 1, roughness: 0.16 });
    const moodMat =3D new THREE.MeshStandardMaterial({ color: linear(mood.hex=
), metalness: 0.55, roughness: 0.18, emissive: linear(mood.hex), emissiveInte=
nsity: 0.45 });

    const H =3D 18, R =3D 1.3, T =3D 2.8;
    const dna =3D new THREE.Group();
    [0, Math.PI].forEach((ph) =3D> {
        dna.add(new THREE.Mesh(new THREE.TubeGeometry(new HelixCurve(R, H, T,=
 ph), lite ? 240 : 520, 0.25, lite ? 14 : 28, false), chrome));
    });
