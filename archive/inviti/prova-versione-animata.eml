// Glitch anche sui titoli: il CSS usa body.glitching e --gx
function domGlitch(on) {
    document.body.classList.toggle('glitching', on);
    if (on) document.body.style.setProperty('--gx', ((Math.random() - 0.5) * =
10).toFixed(1) + 'px');
